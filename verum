#!/usr/bin/env bash
# Verum task runner.
# PHP is not installed on the host, so every PHP command is proxied into Docker.
# Usage: ./verum <command> [args]
set -euo pipefail

cd "$(dirname "$0")"

DC="docker compose"
EXEC="$DC exec -T app"

# Under mirrored WSL networking a host port can read as taken for a few
# seconds after it is released, or while Windows lends it to an outgoing
# connection. Compose leaves that container "created", so a retry starts
# only what is missing. Any other failure is reported at once.
compose_up() {
    local log attempt
    log="$(mktemp)"
    trap 'rm -f "$log"' RETURN
    for attempt in 1 2 3 4 5; do
        if $DC up -d "$@" 2>&1 | tee "$log"; then
            return 0
        fi
        grep -q 'address already in use' "$log" || return 1
        echo "A host port is busy; retrying in $((attempt * 2))s ($attempt/5)." >&2
        sleep $((attempt * 2))
    done
    echo "Still busy. See \"address already in use\" in CLAUDE.md to find the holder." >&2
    return 1
}

# A host port from .env, or the compose default when it is not set.
env_port() {
    local value
    value="$(grep -E "^$1=" .env 2>/dev/null | tail -1 | cut -d= -f2 | tr -d '"' || true)"
    echo "${value:-$2}"
}

usage() {
    cat <<'EOF'
Verum task runner — PHP runs inside Docker, never on the host.

  ./verum up               Start the stack
  ./verum down             Stop the stack
  ./verum ps               Container status
  ./verum logs [service]   Tail logs
  ./verum shell            Bash inside the app container
  ./verum artisan <args>   Run an artisan command
  ./verum composer <args>  Run a composer command
  ./verum npm <args>       Run an npm command
  ./verum migrate          Run migrations
  ./verum fresh            Drop, re-migrate, seed
  ./verum test             Run the test suite
  ./verum lint             Fix style with Pint
  ./verum types            Static analysis with PHPStan
  ./verum check            Full gate: lint + types + tests
  ./verum assets           Build production frontend assets
  ./verum fix-perms        Restore exec bits lost on the WSL bind mount
  ./verum setup            First-time setup
  ./verum urls             Print every local URL
  ./verum health           Check the stack and key pages
EOF
}

cmd="${1:-help}"; shift || true

case "$cmd" in
    up)        compose_up "$@" ;;
    down)      $DC down ;;
    restart)   $DC restart "$@" ;;
    ps)        $DC ps ;;
    logs)      $DC logs -f "$@" ;;
    shell)     $DC exec app bash ;;
    artisan)   $EXEC php artisan "$@" ;;
    composer)  $DC run --rm --no-deps app composer "$@" ;;
    npm)       $DC exec -T -u root vite npm "$@" ;;
    tinker)    $DC exec app php artisan tinker ;;
    migrate)   $EXEC php artisan migrate ;;
    fresh)     $EXEC php artisan migrate:fresh --seed ;;
    seed)      $EXEC php artisan db:seed ;;
    test)      $EXEC php artisan test "$@" ;;
    lint)      $EXEC php ./vendor/bin/pint --parallel ;;
    types)     $EXEC php ./vendor/bin/phpstan analyse --no-progress ;;
    check)
        $EXEC php ./vendor/bin/pint --parallel --test
        $EXEC php ./vendor/bin/phpstan analyse --no-progress
        $EXEC php artisan test
        ;;
    assets)
        $DC exec -T -u root vite sh -c 'cd /var/www/html && npm run build'
        $DC exec -T -u root vite chown -R 1000:1000 /var/www/html/public/build
        ;;
    fix-perms)
        chmod +x vendor/bin/* 2>/dev/null || true
        $DC exec -T -u root vite sh -c \
            'chmod -R +x /var/www/html/node_modules/.bin/ 2>/dev/null || true; chown -R 1000:1000 /var/www/html/node_modules' || true
        echo "Permissions restored."
        ;;
    setup)
        $DC build
        compose_up
        $DC run --rm --no-deps app composer install
        chmod +x vendor/bin/* 2>/dev/null || true
        $EXEC php artisan key:generate
        $EXEC php artisan migrate --force
        $EXEC php artisan storage:link || true
        echo "Ready: http://localhost:$(env_port APP_PORT 8000) | Mail: http://localhost:$(env_port MAILPIT_UI_PORT 8025) | Horizon: http://localhost:$(env_port APP_PORT 8000)/horizon"
        ;;
    urls)
        app="http://localhost:$(env_port APP_PORT 8000)"
        cat <<EOF
App          $app
Shop         $app/shop
Auctions     $app/auctions
Sellers      $app/sellers
Verify       $app/verify/VR-2026-002448
Horizon      $app/horizon
Mailpit      http://localhost:$(env_port MAILPIT_UI_PORT 8025)
Meilisearch  http://localhost:$(env_port MEILI_HOST_PORT 7700)
Reverb       ws://localhost:$(env_port REVERB_HOST_PORT 8080)
Vite (HMR)   http://localhost:$(env_port VITE_PORT 15173)
Postgres     localhost:$(env_port DB_HOST_PORT 5433)  (bundled container)
EOF
        ;;
    health)
        $DC ps --format '{{.Service}}	{{.Status}}'
        echo
        for path in / /shop /auctions /sellers /stones/burmese-ruby /verify /about /up; do
            printf '%-28s ' "$path"
            curl -s -o /dev/null -w 'HTTP %{http_code}\n' "http://localhost:8000$path"
        done
        ;;
    help|--help|-h) usage ;;
    *) echo "Unknown command: $cmd" >&2; echo; usage; exit 1 ;;
esac
