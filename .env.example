APP_NAME=Verum
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Default: the bundled postgres container.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=verum
DB_USERNAME=verum
DB_PASSWORD=12345
#
# To use a Postgres running on Windows (pgAdmin) instead, start the
# pgbridge service and use:
#   DB_HOST=host.docker.internal
#   DB_PORT=5434
#   DB_USERNAME=postgres

# Host-side port mappings (changed to avoid clashes with other local projects)
APP_PORT=8000
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380
REVERB_HOST_PORT=8080
MEILI_HOST_PORT=7700
MAILPIT_UI_PORT=8025
VITE_PORT=5173

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
# Mailtrap sandbox. Ports 2525 and 25 are blocked on some networks; 587 works.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@verum.test
# Follows APP_NAME, so renaming the app renames the sender too.
MAIL_FROM_NAME="${APP_NAME}"
MAIL_DEMO_RECIPIENT=demo@verum.test

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=verum
REVERB_APP_KEY=verumkey
REVERB_APP_SECRET=verumsecret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKeyForLocalDevOnly

HORIZON_PREFIX=verum_horizon

# Host user mapping for Docker bind-mount file ownership
UID=1000
GID=1000

VERUM_DEMO_MODE=true
VERUM_CONTACT_EMAIL=hello@verumgems.com
VERUM_CONTACT_PHONE="+92 300 000 0000"
VERUM_ADDRESS="Saddar Gem Market, Peshawar, Pakistan"
VERUM_INSTAGRAM=
VERUM_YOUTUBE=

# Password reset / change: emails allowed before the cooldown kicks in.
AUTH_RESET_ATTEMPTS=3
AUTH_RESET_DECAY=30
AUTH_CHANGE_ATTEMPTS=3
AUTH_CHANGE_DECAY=30
AUTH_PASSWORD_MIN=10

# URL segments. Rename any of these to change the public URL;
# route names stay the same so nothing else breaks.
# ROUTE_SHOP=shop
# ROUTE_BUYER=buyer
# ROUTE_SELLER=seller
ROUTE_ADMIN=admin

# Google sign-in. The buttons stay disabled until a client id is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
